<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/widget_open_today" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/widget_title" android:textSize="18sp" android:textStyle="bold" android:textColor="#293B50" />
                <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/widget_preview_date" android:textSize="11sp" android:textColor="#607268" android:layout_marginTop="3dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_companion" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="7dp">
                <TextView android:id="@+id/widget_quote" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/widget_preview_quote" android:textSize="12sp" android:lineSpacingExtra="2dp"
                    android:textColor="#2C716C" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_portrait_companion" android:layout_width="76dp" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/widget_portrait" android:layout_width="76dp" android:layout_height="70dp"
                android:scaleType="fitCenter" android:src="@drawable/ic_shike"
                android:contentDescription="@string/widget_mascot" />
            <TextView android:id="@+id/widget_shuffle_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_shuffle_hint" android:textSize="11sp" android:textColor="#607268"
                android:gravity="center" android:layout_marginTop="3dp" android:contentDescription="@string/widget_shuffle_description" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="7dp">
        <ListView android:id="@+id/widget_courses" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@android:color/transparent" android:dividerHeight="4dp" android:scrollbars="vertical"
            android:clipToPadding="false" android:paddingBottom="3dp" />
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:text="@string/widget_empty" android:textSize="13sp" android:textColor="#607268" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_summary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/widget_preview_summary" android:textSize="11sp" android:textColor="#607268" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="28dp"
            android:text="@string/widget_refresh" android:textSize="12sp" android:gravity="center" android:textColor="#2C716C"
            android:contentDescription="@string/widget_refresh_description" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
